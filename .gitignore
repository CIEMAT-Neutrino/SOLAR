# =============================================================================
# Git Ignore Rules for SOLAR Repository
# =============================================================================
#
# This file specifies intentionally untracked files to ignore.
# See: https://git-scm.com/docs/gitignore
#
# Strategy: Only track essential source code, lightweight configs, and docs.
# All generated/auxiliary files are excluded.

# =============================================================================
# SYSTEM / USER FILES - Always Ignore
# =============================================================================

# Shell history
.bash_history
.bash_history-*
.python_history
.zsh_history

# User-specific configuration files
.git-credentials
.gitconfig

# Cryptography and credentials
.pki/
.ssh/
.netrc
*.credentials

# =============================================================================
# IDE / EDITOR / TOOLS - Always Ignore
# =============================================================================

# Visual Studio Code
.vscode/
.vscode-remote-containers/
.vscode-server/
.vscode-container/

# Claude AI
.claude/
.claude.json
.claude.json.tmp.*
.claude.lock/

# Codex
.codex/

# Copilot
.copilot/

# JetBrains / PyCharm
.idea/

# Mistral Vibe
.vibe/

# Jupyter / IPython
.ipython/
profile_default/
ipython_config.py
.jupyter/

# =============================================================================
# CACHE DIRECTORIES - Always Ignore
# =============================================================================

.cache/
.cache/*/

# Specific cache directories
.cache/Microsoft/
.cache/fontconfig/
.cache/jedi/
.cache/matplotlib/
.cache/mozilla/
.cache/pip/
.cache/puppeteer/
.cache/typescript/

# npm cache
.npm/

# Python cache
.pip/
.eggs/

# =============================================================================
# TEMPORARY DIRECTORIES - Always Ignore
# =============================================================================

.tools/
.redhat/
.dotnet/
.local/
.config/

# Browser data
.chrome/
.mozilla/
.texlive2020/

# =============================================================================
# ENVIRONMENT / DEPENDENCY MANAGEMENT - Always Ignore
# =============================================================================

# Python virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Python cache and artifacts
__pycache__/
*.py[cod]
*$py.class
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Poetry and pdm
.pdm.toml
poetry.lock
pdm.lock

# PEP 582
__pypackages__/

# =============================================================================
# TESTING AND COVERAGE - Always Ignore
# =============================================================================

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Test fixtures (binary data)
tests/fixtures/*.pkl
tests/fixtures/*.npy

# =============================================================================
# DOCUMENTATION BUILD - Always Ignore
# =============================================================================

# Sphinx documentation build
docs/_build/

# mkdocs
/site

# =============================================================================
# NOTEBOOKS - Always Ignore
# =============================================================================

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*ipynb_checkpoints*/

# Notebooks themselves
src/notebooks/
output/notebooks/

# =============================================================================
# OUTPUT DIRECTORIES - Always Ignore
# =============================================================================

# All output data, images, logs, and presentations
output/data/**
!output/data/index.json

output/images/**
output/logs/**
output/presentations/**
output/scripts_for_lowe_publication/**
output/docs/**

# =============================================================================
# CONFIGURATION FILES - Ignore Generated/Heavy Configs
# =============================================================================

# Ignore all calibration directories (generated)
config/*/*/*calib/
config/*/*calib/
config/*/*/*/*calib/
config/*/*/*/*/*calib/

# Ignore all JSON and YAML files in nested config directories (generated)
config/*/*/*/*.json
config/*/*/*/*/*.json
config/*/*/*/*/*/*.json
config/*/*/*/*.yaml
config/*/*/*/*/*.yaml
config/*/*/*/*/*/*.yaml

# Ignore specific generated config patterns
config/*/best-sigma-json/**
config/*/*/best-sigma-json/**

# =============================================================================
# EXTERNAL LIBRARY BUILD ARTIFACTS - Ignore
# =============================================================================

# Prob3++ build artifacts
external/Prob3plusplus/*.o
external/Prob3plusplus/*.a
external/Prob3plusplus/*.so
external/Prob3plusplus/python/*.o
external/Prob3plusplus/python/*.so

# NuFast-Earth build artifacts
external/NuFast-Earth/*.o
external/NuFast-Earth/src/*.o
external/NuFast-Earth/python/*.o
external/NuFast-Earth/python/*.so

# =============================================================================
# BINARY AND SERIALIZED DATA FILES - Always Ignore
# =============================================================================

# Pickle files (Python serialized data)
*.pkl

# NumPy data files
*.npy
*.npz

# HDF5 files
*.h5
*.hdf5

# ROOT files
*.root

# Binary data files
*.dat
*.bin

# CSV data files (generated)
*.csv

# Log files
*.log

# Image files
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff

# =============================================================================
# TEMPORARY AND WEB FILES - Always Ignore
# =============================================================================

# Web cache
.wget*
.wget-hsts

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
.Trashes

# =============================================================================
# OTHER - Always Ignore
# =============================================================================

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# pytype
.pytype/

# Cython
cython_debug/

# C extensions
*.so

# Container images
containers/

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Mac OS
.AppleDouble
.LSOverride

# Linux
*~
.nfs*

# =============================================================================
# END OF FILE
# =============================================================================